# ---------------------------------------------------------------
# DEADLINE RESCUE — server-side configuration
# Copy to `.env` and fill in. These values are read ONLY by the
# Node backend and are never sent to the browser.
# ---------------------------------------------------------------

# Server port (the Vite dev server proxies /api to this port)
PORT=3001

# --- Notion (required for real data; app falls back to Demo Mode without it) ---
# Internal integration secret from https://www.notion.so/profile/integrations
NOTION_TOKEN=

# ID (or full URL) of your Student OS assignments/tasks database.
# Either a database ID or a data source ID works.
# Leave empty to auto-detect a shared database whose name contains
# "assignment", "task", "homework" or "deadline".
NOTION_TASKS_DATABASE_ID=

# Page where generated study plans are saved as new sub-pages.
# Leave empty to save next to the tasks database (its parent page).
NOTION_PLANS_PARENT_PAGE_ID=

# Optional: override auto-detected property names in your database
NOTION_PROP_TITLE=
NOTION_PROP_DUE=
NOTION_PROP_STATUS=
NOTION_PROP_COURSE=
NOTION_PROP_TYPE=
NOTION_PROP_PRIORITY=
NOTION_PROP_EFFORT=

# --- Optional LLM for the AI Study Planner (OpenAI-compatible API) ---
# Without a key, the planner uses the built-in rule-based scheduling engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
