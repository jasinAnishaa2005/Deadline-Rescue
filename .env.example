# ---------------------------------------------------------------
# DEADLINE RESCUE — server-side configuration
# Copy to `.env` and fill in. These values are read ONLY by the
# Node backend and are never sent to the browser.
# ---------------------------------------------------------------

# Server port (the Vite dev server proxies /api to this port)
PORT=3001

# --- Notion (required for real data; app falls back to Demo Mode without it) ---
# Internal integration secret from https://www.notion.so/profile/integrations
NOTION_TOKEN=

# ID (or full URL) of your Student OS assignments/tasks database.
# Either a database ID or a data source ID works.
# Leave empty to auto-detect a shared database whose name contains
# "assignment", "task", "homework" or "deadline".
NOTION_ASSIGNMENTS_DATABASE_ID=
# (NOTION_TASKS_DATABASE_ID is accepted as an older alias.)

# Page where generated study plans are saved as new sub-pages.
# Leave empty to save next to the tasks database (its parent page).
NOTION_PLANS_PARENT_PAGE_ID=

# Optional: override auto-detected property names in your database
NOTION_PROP_TITLE=
NOTION_PROP_DUE=
NOTION_PROP_STATUS=
NOTION_PROP_COURSE=
NOTION_PROP_TYPE=
NOTION_PROP_PRIORITY=
NOTION_PROP_EFFORT=

# --- Optional LLM for the AI Study Planner (OpenAI-compatible API) ---
# Without a key, the planner uses the built-in rule-based scheduling engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Frontend (public, not secret) ---
# IANA timezone for the dashboard greeting. Defaults to Asia/Dhaka.
VITE_APP_TIMEZONE=Asia/Dhaka

# --- Deployment mode ---
# public   = anyone on the internet can use the site. Each visitor's assignments stay in
#            their own browser (localStorage). NOTION_TOKEN is ignored and all Notion
#            endpoints are disabled, so your workspace can never be exposed.
# personal = single-user mode for your own computer; uses NOTION_TOKEN above.
# Default: public when NODE_ENV=production (npm start), personal otherwise (npm run dev).
APP_MODE=
# In public mode the server's OPENAI_API_KEY is NOT offered to visitors unless this is "true".
PUBLIC_AI_ENABLED=false
# Set when running behind a reverse proxy / load balancer (e.g. 1 for one proxy hop) so
# rate limiting sees the real client IP.
TRUST_PROXY=
